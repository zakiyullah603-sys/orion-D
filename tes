#include <iostream>
#include <string>

using namespace std;


class Mahasiswa {
private:
    string nim;
    string nama;
    double ipk;
public:
    Mahasiswa(string inputNim, string inputNama, double inputIpk) {
        nim = inputNim;
        nama = inputNama;
        ipk = inputIpk;
    }

    // [TODO: Mahasiswa] Buat Constructor Overloading (hanya menerima nim dan nama, ipk set ke 0.0)
    Mahasiswa(string InputNim, string InputNama){
        nim = InputNim;
        nama = InputNama;
        ipk = 0.0;
    }
    // [TODO: Mahasiswa] Buat Getter untuk atribut nim dan nama
    string getnim(){
        return nim;
    }
    string getnama(){
        return nama;
    }
    // [TODO: Mahasiswa] Buat Setter dan Getter untuk atribut ipk
    double getipk(){
        return ipk;
    }
    double setipk(double i){
        ipk = i;
    }
    // [TODO: Mahasiswa] Buat method tampilkanData()
    virtual void tampilkanData(){
        cout << "Nama Mahasiswa : " << nama << endl;
        cout << "NIM Mahasiswa : " << nim << endl;
        cout << "IPK  Mahasiswa : " << ipk << endl;
    }
    // [TODO: Mahasiswa] Buat method updateData(double ipkBaru)
    void updateData(double ipkBaru){
        setipk(ipkBaru);
    }
    // [TODO: Mahasiswa] Buat method Overloading updateData(string namaBaru, double ipkBaru)
    virtual void updateData(string namaBaru, double ipkBaru){
        nama = namaBaru;
        ipk = ipkBaru;
    }
};


// [TODO: Mahasiswa] Buat class AsistenPraktikum yang mewarisi class Mahasiswa secara public
class AsistenPraktikum : public Mahasiswa
// Jangan lupa tambahkan atribut 'mataKuliah' (private), Base Class Constructor, dan Override tampilkanData()
{
    private:
    string mataKuliah;

    public:
    AsistenPraktikum (string inputNim, string inputNama, double inputIPK, string mk):Mahasiswa(inputNim, inputNama, inputIPK){
        mataKuliah = mk;
    }
    void tampilkanData() override{ 
        Mahasiswa :: tampilkanData();
        cout << "Mata Kuliah : " << mataKuliah << endl;
    }
};

